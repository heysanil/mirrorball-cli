{
  "name": "mirb-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "mirb.dev \u2014 the mirrorball documentation site",
  "scripts": {
    "predev": "node ./scripts/sync-installers.mjs",
    "dev": "fumapress dev",
    "prebuild": "node ./scripts/sync-installers.mjs && node ./scripts/check-docs.mjs",
    "build": "fumapress build && node ./scripts/strip-server-deploy.mjs",
    "start": "fumapress start",
    "types:check": "tsc --noEmit",
    "check:docs": "node ./scripts/check-docs.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "fumadocs-core": "16.15.1",
    "fumadocs-mdx": "15.3.1",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.15.1",
    "fumapress": "1.1.0",
    "mermaid": "11.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remark-directive": "4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "github-slugger": "2.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "wrangler": "4.125.0"
  }
}
